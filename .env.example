# recourse — environment. Copy to .env and fill in. NEVER commit .env.
# .env is git-ignored. Keys are testnet-only throwaways. Nothing secret here
# ever goes on chain or into the frontend bundle.

# ---------------------------------------------------------------- network
# Hoodi testnet (chain 560048). Defaults are the canonical vara.eth endpoints;
# override only to point at a private node.
RECOURSE_RPC_HTTP=https://hoodi-reth-rpc.gear-tech.io
RECOURSE_RPC_WS=wss://hoodi-reth-rpc.gear-tech.io/ws

# ---------------------------------------------------------- service keys
# One 32-byte hex private key per role (with or without 0x prefix).
# Generate a fresh set with:  cast wallet new   (or scripts/gen-keys.ts)
# The deployer must hold hoodi ETH (faucet: https://eth.vara.network/faucet).
# scripts/fund.ts fans ETH from the deployer out to the other roles.
RECOURSE_DEPLOYER_PK=
RECOURSE_REQUESTER_PK=
RECOURSE_BOT_STEADY_PK=
RECOURSE_BOT_CHEAPSKATE_PK=
RECOURSE_BOT_PREMIUM_PK=
RECOURSE_VERIFIER_PK=
RECOURSE_KEEPER_PK=

# ---------------------------------------------------- economics (deploy)
# Set at program init. Values are wei. Defaults are the demo economics.
RECOURSE_BOND_WEI=20000000000000000        # 0.02 ETH provider bond
RECOURSE_SLASH_WEI=10000000000000000       # 0.01 ETH slashed on breach
RECOURSE_SLASH_TO_REQUESTER_BPS=5000       # 50% of the slash to the requester

# ------------------------------------------------------------ bot models
# Default backend is `mock` (deterministic, offline, zero keys). Model keys
# are read ONLY by the bots and only when a real backend is selected. Leave
# blank to keep the whole repo runnable with no external calls.
RECOURSE_MODEL_BACKEND=mock                # mock | anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Per-bot demo failure injection (cheapskate persona). Unset = honest.
# FAIL_MODE=timeout | bad_json | wrong_code
FAIL_MODE=
