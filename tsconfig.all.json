{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2023"], "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "noEmit": true, "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@recourse/sdk": ["./packages/sdk/src/index.ts"],
      "@recourse/tasks": ["./packages/tasks/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "scripts/**/*.ts"]
}
